    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "print(\"Loading raw dataset...\")\n",
        "df_raw = sns.load_dataset('titanic')\n",
        "\n",
        "# Save offline fallback immediately\n",
        "df_raw.to_csv(\"titanic.csv\", index=False)\n",
        "df = pd.read_csv(\"titanic.csv\")\n",
        "\n",
        "print(\"\\n--- Dataset Profile ---\")\n",
        "df.info()\n",
        "print(\"\\nShape:\", df.shape)\n",
        "print(\"\\nSummary Stats:\\n\", df.describe())\n",
        "\n",
        "print(\"\\n--- Missing Value Percentages ---\")\n",
        "missing_pct = (df.isnull().sum() / len(df)) * 100\n",
        "print(missing_pct[missing_pct > 0])\n",
        "\n",
        "# 2. MISSING VALUE HANDLING (THRESHOLD RULE)\n",
        "# Rule: <5% drop rows, 5-30% impute, >30% drop col or encode\n",
        "# embarked / embark_town (0.22% missing) -> <5% -> Drop rows\n",
        "df.dropna(subset=['embarked', 'embark_town'], inplace=True)\n",
        "\n",
        "# age (19.8% missing) -> 5-30% -> Impute with median\n",
        "df['age'] = df['age'].fillna(df['age'].median())\n",
        "\n",
        "# deck (77.2% missing) -> >30% -> Encode as 'Missing' (Justified in README)\n",
        "# We convert categorical to object first to allow new category, fill, then convert back.\n",
        "df['deck'] = df['deck'].astype(str).replace('nan', 'Missing')\n",
        "\n",
        "# Drop completely redundant columns to prevent multicollinearity\n",
        "df.drop(columns=['alive', 'class', 'embark_town'], inplace=True)\n",
        "\n",
        "# 3. UNIVARIATE ANALYSIS & OUTLIERS (IQR)\n",
        "def calculate_outliers(series):\n",
        "    Q1 = series.quantile(0.25)\n",
        "    Q3 = series.quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "    lower_bound = Q1 - 1.5 * IQR\n",
        "    upper_bound = Q3 + 1.5 * IQR\n",
        "    return ((series < lower_bound) | (series > upper_bound)).sum()\n",
        "\n",
        "print(f\"\\nAge Outliers (IQR): {calculate_outliers(df['age'])}\")\n",
        "print(f\"Fare Outliers (IQR): {calculate_outliers(df['fare'])}\")\n",
        "\n",
        "fare_mean = df['fare'].mean()\n",
        "fare_median = df['fare'].median()\n",
        "# Mode can return multiple values, take the first\n",
        "fare_mode = df['fare'].mode().iloc[0]\n",
        "\n",
        "print(f\"\\nFare - Mean: {fare_mean:.2f}, Median: {fare_median:.2f}, Mode: {fare_mode:.2f}\")\n",
        "\n",
        "# Plotting Univariate\n",
        "fig, axes = plt.subplots(2, 2, figsize=(12, 10))\n",
        "sns.histplot(df['age'], kde=True, ax=axes[0,0]).set_title('Age Distribution')\n",
        "sns.boxplot(x=df['age'], ax=axes[0,1]).set_title('Age Boxplot')\n",
        "sns.histplot(df['fare'], kde=True, bins=40, ax=axes[1,0]).set_title('Fare Distribution')\n",
        "sns.boxplot(x=df['fare'], ax=axes[1,1]).set_title('Fare Boxplot')\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"01_univariate.png\")\n",
        "\n",
        "# 4. BIVARIATE ANALYSIS & CORRELATION\n",
        "print(\"\\n--- Survival Rates ---\")\n",
        "print(\"By Sex:\\n\", df.groupby('sex')['survived'].mean())\n",
        "print(\"\\nBy Pclass:\\n\", df.groupby('pclass')['survived'].mean())\n",
        "print(\"\\nBy Sex and Pclass:\\n\", df.groupby(['sex', 'pclass'])['survived'].mean())\n",
        "\n",
        "# Correlation Matrix (Restricted to 6 specific columns)\n",
        "corr_cols = ['survived', 'pclass', 'age', 'sibsp', 'parch', 'fare']\n",
        "corr_matrix = df[corr_cols].corr()\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "sns.heatmap(corr_matrix, annot=True, cmap='coolwarm', fmt=\".2f\")\n",
        "plt.title(\"Correlation Matrix (Numeric Target & Features)\")\n",
        "plt.savefig(\"02_correlation_heatmap.png\")\n",
        "\n",
        "# Rank off-diagonal correlations\n",
        "corr_pairs = corr_matrix.unstack().reset_index()\n",
        "corr_pairs.columns = ['Feature 1', 'Feature 2', 'Correlation']\n",
        "corr_pairs = corr_pairs[corr_pairs['Feature 1'] != corr_pairs['Feature 2']]\n",
        "corr_pairs['Abs_Corr'] = corr_pairs['Correlation'].abs()\n",
        "top_2_corr = corr_pairs.sort_values(by='Abs_Corr', ascending=False).drop_duplicates(subset=['Abs_Corr']).head(2)\n",
        "print(\"\\nTop 2 Strongest Correlations:\\n\", top_2_corr[['Feature 1', 'Feature 2', 'Correlation']])\n",
        "\n",
        "# 5. MULTIVARIATE DATA STORY CHARTS\n",
        "fig, axes = plt.subplots(2, 2, figsize=(15, 12))\n",
        "\n",
        "# Chart 1: Survival by Sex and Class\n",
        "sns.barplot(data=df, x='pclass', y='survived', hue='sex', ax=axes[0,0])\n",
        "axes[0,0].set_title('1. Survival Rate by Pclass and Sex')\n",
        "\n",
        "# Chart 2: Age vs Fare colored by Survival\n",
        "sns.scatterplot(data=df, x='age', y='fare', hue='survived', alpha=0.6, ax=axes[0,1])\n",
        "axes[0,1].set_title('2. Age vs Fare by Survival')\n",
        "\n",
        "# Chart 3: Age Distribution by Survival\n",
        "sns.violinplot(data=df, x='survived', y='age', hue='survived', ax=axes[1,0])\n",
        "axes[1,0].set_title('3. Age Distribution of Survivors vs Non-Survivors')\n",
        "\n",
        "# Chart 4: Family Size vs Survival\n",
        "df['family_size'] = df['sibsp'] + df['parch'] + 1\n",
        "sns.pointplot(data=df, x='family_size', y='survived', ax=axes[1,1])\n",
        "axes[1,1].set_title('4. Survival Rate by Family Size')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"03_multivariate_story.png\")\n",
        "\n",
        "# 6. STANDARDIZATION SANITY CHECK\n",
        "print(\"\\n--- Standardization Check ---\")\n",
        "scaler = StandardScaler()\n",
        "df_scaled = df.copy()\n",
        "df_scaled[['age_z', 'fare_z']] = scaler.fit_transform(df[['age', 'fare']])\n",
        "\n",
        "print(\"BEFORE - Age Mean:\", df['age'].mean(), \"Std:\", df['age'].std())\n",
        "print(\"BEFORE - Fare Mean:\", df['fare'].mean(), \"Std:\", df['fare'].std())\n",
        "print(\"AFTER  - Age Mean:\", df_scaled['age_z'].mean(), \"Std:\", df_scaled['age_z'].std())\n",
        "print(\"AFTER  - Fare Mean:\", df_scaled['fare_z'].mean(), \"Std:\", df_scaled['fare_z'].std())\n",
        "\n",
        "# Save finalized cleaned DF for the modeling pipeline\n",
        "df.to_csv(\"titanic_cleaned.csv\", index=False)"
      ],
